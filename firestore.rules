rules_version = '2';
// Only the app's login can read or change anything. Paste into Firebase console → Firestore Database → Rules.
// The email is the login added under Authentication → Users.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null && request.auth.token.email == 'baljinder2128@gmail.com';
    }
  }
}
