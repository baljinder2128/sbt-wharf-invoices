rules_version = '2';
// Only the app's login can read or change anything. Paste into Firebase console → Firestore Database → Rules,
// with YOUR-LOGIN-EMAIL replaced by the email of the user added under Authentication → Users.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null && request.auth.token.email == 'YOUR-LOGIN-EMAIL';
    }
  }
}
